{
  "name": "roadmap-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/lib/db/migrate.ts",
    "db:seed": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/lib/db/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "6.0.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@neon/config": "1.7.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}

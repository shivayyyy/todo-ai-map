# Neon PostgreSQL (Neon dashboard -> Connect)
DATABASE_URL=

# Better Auth (self-hosted on Neon Postgres)
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 ; Production: your deployed https URL
BETTER_AUTH_URL=

# Upstash Redis over TCP (rediss://...). Optional; caching fails open if unset.
REDIS_URL=

# Bump this value whenever seeded roadmap content changes to invalidate shared cache.
ROADMAP_CACHE_VERSION=v1
